window-decoration = auto
working-directory = home
window-inherit-working-directory = false
font-family = "Iosevka Fixed SS14"
font-family = "Sarasa Fixed SC"
font-size = 16
#adjust-cell-height = 10%
shell-integration = detect
shell-integration-features = no-cursor,no-title,ssh-env,ssh-terminfo,path
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

theme = "Flexoki Light"
macos-titlebar-style = tabs
window-title-font-family = "Iosevka Fixed SS14"
window-title-font-family = "Sarasa Fixed SC"
